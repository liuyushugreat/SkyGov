# Byte-compiled / optimised / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Build artefacts
build/
dist/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
env/
.env

# LaTeX / office scratch files
*.aux
*.log
*.out
*.toc
*.synctex.gz
~$*.docx
~$*.xlsx

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local scratch.  NOTE: these patterns are anchored to the repository root and
# require an explicit `_scratch_` prefix on purpose.  A bare `_*.py` pattern
# would also match every package `__init__.py` and silently break the release.
/_scratch_*.py
/_scratch_*.txt
/scratch/
